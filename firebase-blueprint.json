{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Represents an educational course offered by the institute.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "duration": { "type": "string" },
        "mode": { "type": "string" },
        "fee": { "type": "number" },
        "certificateIncluded": { "type": "boolean" },
        "modules": { "type": "array" },
        "description": { "type": "string" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["id", "name", "duration", "fee"]
    },
    "Student": {
      "title": "Student",
      "description": "Represents a student enrolled at the institute.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "enrolledCourseId": { "type": "string" },
        "enrolledCourseName": { "type": "string" },
        "enrollmentId": { "type": "string" },
        "enrollmentDate": { "type": "string" },
        "agreedFee": { "type": "number" },
        "totalPaid": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "isDeactivated": { "type": "boolean" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "enrolledCourseName", "agreedFee", "paymentStatus"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Represents an invoice issued to a student for course enrolment fees.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhone": { "type": "string" },
        "studentEmail": { "type": "string" },
        "enrollmentId": { "type": "string" },
        "courseName": { "type": "string" },
        "courseDuration": { "type": "string" },
        "courseFee": { "type": "number" },
        "discount": { "type": "number" },
        "totalPayable": { "type": "number" },
        "amountPaid": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "isStudentDeactivated": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "studentId", "studentName", "courseName", "totalPayable", "paymentStatus"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Represents a payment receipt recorded for student course payments.",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "paymentDate": { "type": "string" },
        "amountReceived": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "remainingBalanceAfter": { "type": "number" },
        "transactionRef": { "type": "string" },
        "isStudentDeactivated": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["receiptNumber", "invoiceNumber", "studentId", "studentName", "paymentDate", "amountReceived"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Represents a verifiable completion certificate issued to a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "courseName": { "type": "string" },
        "courseMode": { "type": "string" },
        "courseDuration": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "issueDate": { "type": "string" },
        "certificateNumber": { "type": "string" },
        "verificationCode": { "type": "string" },
        "signatories": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentName", "courseName", "startDate", "endDate", "issueDate", "verificationCode"]
    },
    "PhaseAssignment": {
      "title": "PhaseAssignment",
      "description": "Represents the active exclusive phase assignment of a student (Phase 1 Keval, Phase 2 Hiren, Phase 3 Shweta).",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "phase": { "type": "number", "enum": [1, 2, 3] },
        "assignedPerson": { "type": "string", "enum": ["Keval", "Hiren", "Shweta"] },
        "assignedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["studentId", "phase", "assignedPerson", "assignedAt"]
    },
    "PhaseAuditLog": {
      "title": "PhaseAuditLog",
      "description": "Audit trail logging every phase transfer and modification with timestamp and user ID.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "previousPhase": { "type": "number" },
        "newPhase": { "type": "number" },
        "changedBy": { "type": "string" },
        "timestamp": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "studentId", "newPhase", "timestamp"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Collection of courses offered by the institute."
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of enrolled student profiles and fee tracking records."
    },
    "/invoices/{invoiceNumber}": {
      "schema": "Invoice",
      "description": "Collection of financial invoices generated for admissions and fee billing."
    },
    "/receipts/{receiptNumber}": {
      "schema": "Receipt",
      "description": "Collection of payment receipts issued for received student fee transactions."
    },
    "/certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Collection of issued student completion certificates verifiable globally across any device."
    },
    "/phase_assignments/{studentId}": {
      "schema": "PhaseAssignment",
      "description": "Collection of exclusive Phase assignments ensuring one phase per student."
    },
    "/phase_audit_logs/{logId}": {
      "schema": "PhaseAuditLog",
      "description": "Collection of immutable audit logs tracking student transfers between phases."
    }
  }
}
